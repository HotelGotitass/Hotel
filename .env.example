# Plantilla de variables de entorno del backend. Copia a .env (ignorado por git) y completa.
# NUNCA subas valores reales al repositorio.

DB_URL=jdbc:postgresql://localhost:5432/hotel
DB_USERNAME=
DB_PASSWORD=

# Base64, minimo 32 bytes. Generar: openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRATION=86400000

CORS_ALLOWED_ORIGINS=http://localhost:5173

# SMTP (Gmail con contrasena de aplicacion)
MAIL_USERNAME=
MAIL_PASSWORD=

# Mercado Pago (Payment Brick). La Public Key se entrega al frontend en /api/v1/public/payments/config
MP_ACCESS_TOKEN=
MP_PUBLIC_KEY=

# URLs publicas (BACKEND_URL debe ser https para recibir webhooks)
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8080

# Emisor de comprobantes simulados (opcional)
BILLING_RUC=
BILLING_NAME=
BILLING_ADDRESS=

PORT=8080
